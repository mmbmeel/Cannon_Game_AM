<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_battle_textbox"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Título do Diálogo (Vitória ou Derrota) -->
    <TextView
        android:id="@+id/txtDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FIM DE JOGO"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        android:shadowColor="@color/palette_pink"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="4" />

    <!-- Estatísticas da Partida -->
    <TextView
        android:id="@+id/txtDialogStats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:lineSpacingExtra="6dp"
        android:text="Estatísticas..."
        android:textColor="@color/white"
        android:textSize="18sp" />

    <!-- Botão Jogar Novamente -->
    <Button
        android:id="@+id/btnDialogReset"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_action_button"
        android:text="@string/reset_game"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Botão Voltar ao Menu -->
    <Button
        android:id="@+id/btnDialogMenu"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/bg_menu_button"
        android:text="@string/back_to_menu"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>
