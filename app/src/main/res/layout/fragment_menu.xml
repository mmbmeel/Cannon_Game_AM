<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <FrameLayout
            android:layout_width="188dp"
            android:layout_height="188dp"
            android:layout_marginBottom="16dp">

            <com.uemg.cannon_game_am.PixelPokeballView
                android:id="@+id/menuPokeball"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Pixel art capture ball" />

            <Button
                android:id="@+id/btnPlay"
                android:layout_width="142dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_battle_textbox"
                android:fontFamily="monospace"
                android:stateListAnimator="@null"
                android:text="@string/play"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />
        </FrameLayout>

        <TextView
            android:id="@+id/txtMenuHighScore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_battle_textbox"
            android:fontFamily="monospace"
            android:gravity="center"
            android:padding="12dp"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:clickable="false"
            android:focusable="false" />

        <Button
            android:id="@+id/btnHowToPlay"
            android:layout_width="260dp"
            android:layout_height="48dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_menu_button"
            android:fontFamily="monospace"
            android:stateListAnimator="@null"
            android:text="@string/how_to_play"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSound"
            android:layout_width="260dp"
            android:layout_height="48dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_menu_button"
            android:fontFamily="monospace"
            android:stateListAnimator="@null"
            android:text="@string/sound_on"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnExit"
            android:layout_width="260dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_menu_button"
            android:fontFamily="monospace"
            android:stateListAnimator="@null"
            android:text="@string/exit"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
